[Unit]
Description=OmniFlow (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=omniflow
WorkingDirectory=/opt/omniflow/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/omniflow

[Install]
WantedBy=multi-user.target
